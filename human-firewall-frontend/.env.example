# En el monolito la interfaz y la API comparten origen, asi que NO hace falta
# definir nada: dejar VITE_API_URL vacio hace que el frontend use rutas
# relativas y funcione igual en local que desplegado.
#
# Solo se define si se quiere apuntar a un backend que corre en otro lado.
# VITE_API_URL=http://localhost:3000
VITE_API_URL=
