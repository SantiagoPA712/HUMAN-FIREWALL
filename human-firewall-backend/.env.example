# NO uses este archivo directamente: corre `npm run setup`, que genera el .env
# con un JWT_SECRET aleatorio y la base ya apuntada. Esto queda solo como
# referencia de que variables existen.
#
# El archivo .env NO se sube al repositorio.

# --- Base de datos ---
# Apunta al contenedor de docker-compose.yml (se levanta con: docker compose up -d).
# El puerto es 5433 y no 5432: si tenes PostgreSQL instalado en tu maquina, ese
# ya ocupa el 5432 y las conexiones terminan yendo ahi.
#
# Para usar Supabase, reemplaza esta linea por la cadena del panel:
# Settings > Database > Connection string, modo URI.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/postgres

# --- Servidor ---
PORT=3000

# --- Autenticacion JWT ---
# Obligatorio. Sin este valor el servidor arranca pero firma los tokens con la
# cadena 'secret', y con eso cualquiera puede fabricarse un token de admin.
# `npm run setup` genera uno solo. A mano:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES=1d

# --- Google OAuth (SSO) ---
# Opcionales: sin ellos funciona todo salvo el boton de "entrar con Google".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Correo saliente (notificaciones por eventos) ---
# TODAS opcionales. Sin SMTP_HOST el sistema funciona igual: los avisos de
# bienvenida, nivel nuevo y recompensa quedan en la bandeja de la aplicacion
# (GET /api/notifications) y no se manda ningun correo. Es el modo por defecto
# para desarrollo y para la entrega.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Human Firewall <no-reply@humanfirewall.local>

# --- Reportes automaticos periodicos ---
# Todas opcionales; abajo estan los valores que usa el sistema si no se definen.
#
# Cada cuanto revisa el scheduler si vencio alguna programacion. NO es la
# frecuencia de los reportes (esa vive en report_schedules.frequency): es cada
# cuanto se mira el reloj.
REPORT_SCHEDULER_INTERVAL_SECONDS=60
#
# Base del backoff de los avisos, en segundos. La espera es base * 2^intento:
# 2, 4 y 8 minutos con el valor por defecto. Son 3 intentos y despues el aviso
# queda marcado como fallido definitivamente.
REPORT_NOTIFY_BACKOFF_SECONDS=60
#
# A que roles se avisa cuando FALLA la generacion de un reporte. Ese aviso
# lleva el detalle tecnico, asi que no puede ir a los roles de negocio: RH,
# seguridad y gerencia ven un mensaje generico.
REPORT_TECH_ROLES=admin

# --- KPIs organizacionales ---
# Cada cuanto recalcula el job los snapshots de org_kpi_snapshots. El endpoint
# organizacional lee de esa tabla y nunca de points_ledger, asi que este valor
# define que tan fresco es lo que ve gerencia.
ORG_KPI_JOB_INTERVAL_HOURS=24
