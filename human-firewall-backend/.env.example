# NO uses este archivo directamente: corre `npm run setup`, que genera el .env
# con un JWT_SECRET aleatorio y la base ya apuntada. Esto queda solo como
# referencia de que variables existen.
#
# El archivo .env NO se sube al repositorio.

# --- Base de datos ---
# Apunta al contenedor de docker-compose.yml (se levanta con: docker compose up -d).
# El puerto es 5433 y no 5432: si tenes PostgreSQL instalado en tu maquina, ese
# ya ocupa el 5432 y las conexiones terminan yendo ahi.
#
# Para usar Supabase, reemplaza esta linea por la cadena del panel:
# Settings > Database > Connection string, modo URI.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/postgres

# --- Servidor ---
PORT=3000

# --- Autenticacion JWT ---
# Obligatorio. Sin este valor el servidor arranca pero firma los tokens con la
# cadena 'secret', y con eso cualquiera puede fabricarse un token de admin.
# `npm run setup` genera uno solo. A mano:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES=1d

# --- Google OAuth (SSO) ---
# Opcionales: sin ellos funciona todo salvo el boton de "entrar con Google".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Correo saliente (notificaciones por eventos) ---
# TODAS opcionales. Sin SMTP_HOST el sistema funciona igual: los avisos de
# bienvenida, nivel nuevo y recompensa quedan en la bandeja de la aplicacion
# (GET /api/notifications) y no se manda ningun correo. Es el modo por defecto
# para desarrollo y para la entrega.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Human Firewall <no-reply@humanfirewall.local>
